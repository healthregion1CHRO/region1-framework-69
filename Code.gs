function sheet_(name, header){
  let sh = ss_().getSheetByName(name);
  if(!sh){ sh = ss_().insertSheet(name); if(header){ sh.getRange(1,1,1,header.length).setValues([header]).setFontWeight('bold'); sh.setFrozenRows(1); } }
  return sh;
}

/** รันครั้งแรกครั้งเดียว: สร้างชีต Users, Units, Counts, Ucfg, Log */
function setup(){
  sheet_('Users', ['username','password','ชื่อหน่วยงาน','จังหวัด','role (admin/unit)','ชื่อผู้ใช้ที่แสดง','password_hash','salt','unit_id']);
  const u = sheet_('Units', ['unit_id','ประเภท','ชื่อหน่วยงาน','จังหวัด']);
  u.getRange(2,1,u.getMaxRows()-1,4).clearContent();
  u.getRange(2,1,UNITS.length,4).setValues(UNITS);
  sheet_('Counts', ['id','data (JSON)','unit_id','j18','updated_by','updated_at']);
  sheet_('Ucfg',   ['id','data (JSON)','unit_id','updated_by','updated_at']);
  sheet_('Log',    ['เวลา','ผู้ใช้','การกระทำ','รายละเอียด']);
  SpreadsheetApp.getUi && SpreadsheetApp.getActive().toast('สร้างชีตเรียบร้อย กรอกชีต Users แล้วรัน hashPasswords()');
}

function sha_(text){
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8)
    .map(b => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}

/** แปลงรหัสผ่านในคอลัมน์ password เป็นค่าแฮช แล้วลบรหัสผ่านตัวจริงออก + จับคู่ unit_id */
function hashPasswords(){
  const sh = sheet_('Users'); const v = sh.getDataRange().getValues(); let n=0, miss=[];
  for(let r=1; r<v.length; r++){
    const row=v[r]; if(!row[0]) continue;
    if(row[1] !== '' && row[1] != null){
      const salt = Utilities.getUuid(); row[6] = sha_(salt + String(row[1])); row[7] = salt; row[1] = ''; n++;
    }
    const role = String(row[4]||'unit').trim().toLowerCase(); row[4] = role==='admin'?'admin':'unit';
    if(row[4]==='unit'){
      const hit = UNITS.find(x => x[2]===String(row[2]).trim() && (!row[3] || x[3]===String(row[3]).trim()));
      row[8] = hit ? hit[0] : ''; if(!hit) miss.push(row[0]);
    } else row[8] = '';
    sh.getRange(r+1,1,1,row.length).setValues([row]);
  }
  const msg = 'แฮชรหัสผ่านแล้ว ' + n + ' บัญชี' + (miss.length ? ' · ไม่พบชื่อหน่วยงานของ: ' + miss.join(', ') + ' (ตรวจชื่อให้ตรงกับชีต Units)' : '');
  Logger.log(msg); try{ SpreadsheetApp.getActive().toast(msg, 'hashPasswords', 15); }catch(e){}
}

function out_(obj){ return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
/** กัน formula injection: ค่าที่ขึ้นต้นด้วย = + - @ หรือ tab/CR จะถูกนำหน้าด้วย ' และตัดความยาว */
function safe_(v){ let t = String(v == null ? '' : v).slice(0, 200); return /^[=+\-@\t\r]/.test(t) ? "'" + t : t; }
function log_(user, act, detail){ try{ sheet_('Log').appendRow([new Date(), safe_(user), act, safe_(detail)]); }catch(e){} }

function doGet(){ return out_({ok:true, service:'region1-framework-69'}); }

function doPost(e){
  try{
    const req = JSON.parse(e.postData.contents || '{}');
    if(req.action === 'login')  return out_(login_(req));
    const s = session_(req.token); if(!s) return out_({ok:false, code:'auth', error:'กรุณาเข้าสู่ระบบใหม่'});
    if(req.action === 'logout'){ CacheService.getScriptCache().remove('t_'+req.token); return out_({ok:true}); }
    if(req.action === 'list')   return out_(list_(s, req.collection));
    if(req.action === 'set')    return out_(set_(s, req.collection, req.id, req.data));
    return out_({ok:false, code:'bad_request', error:'unknown action'});
  }catch(err){ log_('-', 'error', String(err)); return out_({ok:false, code:'error', error:'เกิดข้อผิดพลาดในระบบ'}); }
}

function login_(req){
  const user = String(req.username||'').trim(), pass = String(req.password||'');
  const cache = CacheService.getScriptCache(), fkey = 'f_' + sha_(user).slice(0, 32);
  if(Number(cache.get(fkey) || 0) >= MAX_FAILS) { log_(user,'login-locked',''); return {ok:false, code:'locked', error:'ลองผิดหลายครั้งเกินไป กรุณารอ 15 นาทีแล้วลองใหม่'}; }
  const v = sheet_('Users').getDataRange().getValues();
  for(let r=1; r<v.length; r++){
    const row=v[r]; if(String(row[0]).trim() !== user || !row[6]) continue;
    if(sha_(row[7] + pass) !== row[6]) break;
    cache.remove(fkey);
    const token = Utilities.getUuid() + Utilities.getUuid().slice(0,8);
    const session = { token, username:user, name:row[5]||user, role:row[4]==='admin'?'admin':'unit',
      unitId: row[4]==='admin' ? null : (row[8]===''?null:Number(row[8])), unitName: row[2]||'' };
    if(session.role==='unit' && session.unitId==null) return {ok:false, code:'bad_login', error:'บัญชีนี้ยังไม่ได้ผูกหน่วยงาน'};
    session.prov = session.role==='unit' ? provOf_(session.unitId) : null;
    if(session.role==='unit' && !session.prov) return {ok:false, code:'bad_login', error:'ไม่พบจังหวัดของหน่วยงาน'};
    CacheService.getScriptCache().put('t_'+token, JSON.stringify(session), SESSION_HOURS*3600);
    log_(user,'login',''); return {ok:true, session};
  }
  cache.put(fkey, String(Number(cache.get(fkey) || 0) + 1), LOCK_MINUTES * 60);
  Utilities.sleep(800); log_(user,'login-failed',''); return {ok:false, code:'bad_login', error:'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง'};
}
/** จังหวัดของหน่วยงาน (id) จากตาราง UNITS */
function provOf_(id){ const h = UNITS.find(x => x[0]===id); return h ? h[3] : null; }
function session_(token){ if(!token) return null; const j = CacheService.getScriptCache().get('t_'+token); return j ? JSON.parse(j) : null; }
const COLS_ = {counts:'Counts', ucfg:'Ucfg'};
function unitOf_(collection, id){ id = String(id); const m = collection==='ucfg' ? /^u(\d+)$/.exec(id) : /^u(\d+)__[A-Za-z0-9_.\-]{1,80}$/.exec(id); return m ? Number(m[1]) : null; }

function list_(s, collection){
  const name = COLS_[collection]; if(!name) return {ok:false, code:'bad_request', error:'bad collection'};
  const v = sheet_(name).getDataRange().getValues(), docs=[];
  for(let r=1; r<v.length; r++){
    const id = v[r][0]; if(!id) continue;
    if(s.role!=='admin' && provOf_(unitOf_(collection,id))!==s.prov) continue;
    try{ docs.push({id, data: JSON.parse(v[r][1])}); }catch(e){}
  }
  return {ok:true, docs};
}

function set_(s, collection, id, data){
  const name = COLS_[collection]; if(!name || !id) return {ok:false, code:'bad_request', error:'bad request'};
  const uid = unitOf_(collection, id);
  if(uid==null) return {ok:false, code:'bad_request', error:'bad id'};
  if(s.role!=='admin' && provOf_(uid)!==s.prov) return {ok:false, code:'permission_denied', error:'ไม่มีสิทธิ์แก้ไขหน่วยงานนี้'};
  if(data == null || typeof data !== 'object' || Array.isArray(data)) return {ok:false, code:'bad_request', error:'bad data'};
  const json = JSON.stringify(data);
  if(json.length > MAX_DATA_CHARS) return {ok:false, code:'too_large', error:'ข้อมูลมีขนาดใหญ่เกินไป'};
  const numOrNull = x => x == null || x === '' || (typeof x === 'number' && isFinite(x));
  const isInt = x => typeof x === 'number' && isFinite(x) && x >= 0 && Math.floor(x) === x;
  if(collection === 'counts' && !(numOrNull(data.j18) && numOrNull(data.real))) return {ok:false, code:'bad_request', error:'ค่าตัวเลขไม่ถูกต้อง'};
  if(collection === 'ucfg' && !((data.skip == null || (Array.isArray(data.skip) && data.skip.every(isInt))) &&
     (data.add == null || (Array.isArray(data.add) && data.add.every(a => a && isInt(a.i) && isInt(a.mi) && isInt(a.gi))))))
    return {ok:false, code:'bad_request', error:'รูปแบบการตั้งค่าไม่ถูกต้อง'};
  const j18 = (data.j18 != null && isFinite(Number(data.j18))) ? Number(data.j18) : '';
  const lock = LockService.getScriptLock(); lock.waitLock(10000);
  try{
    const sh = sheet_(name), now = new Date();
    const f = sh.getRange('A:A').createTextFinder(id).matchEntireCell(true).findNext();
    const row = collection==='counts'
      ? [id, json, uid, j18, safe_(s.username), now]
      : [id, json, uid, safe_(s.username), now];
    if(f) sh.getRange(f.getRow(),1,1,row.length).setValues([row]); else sh.appendRow(row);
  } finally { lock.releaseLock(); }
  return {ok:true};
}
